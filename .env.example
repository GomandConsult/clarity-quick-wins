# Resend (https://resend.com) — used to send the diagnostic report and
# follow-up emails. Requires the sending domain (clarity.gomandconsult.com)
# to be verified in Resend.
RESEND_API_KEY=

# Optional: send a BCC copy of every report (e.g. for QA in preview deploys).
SEND_REPORT_BCC=

# HubSpot Private App access token — used to create/update the contact
# record for each completed diagnostic, and by the scheduled follow-up
# function to find who's due for the motivational nudge email.
HUBSPOT_KEY=
